{
  "expo": {
    "name": "DriveWallet",
    "slug": "DriveWallet",
    "version": "5.4.32",
    "orientation": "portrait",
    "icon": "./assets/images/drivewallet_sinfondo.png",
    "scheme": "com.jrdev.drivewallet",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/drivewallet_sinfondo.png"
    },
    "android": {
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "VIBRATE",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/logo_new.png",
        "monochromeImage": "./assets/images/logo_new.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jrdev.DriveWallet",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/drivewallet_sinfondo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/drivewallet_sinfondo.png",
          "color": "#00BCD4",
          "defaultChannel": "DriveWallet_Max_Channel"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "DriveWallet necesita tu micrófono para guardar los comandos de voz de gastos e ingresos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DriveWallet necesita acceso a tus fotos para escanear recibos, facturas y comprobantes con IA.",
          "cameraPermission": "DriveWallet necesita acceso a tu cámara para tomar fotos de tus recibos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212",
          "image": "./assets/images/drivewallet_sinfondo.png",
          "imageWidth": 350
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "QuickAddWidget",
              "label": "DriveWallet Rápido",
              "minWidth": "150dp",
              "minHeight": "110dp",
              "description": "Agrega ingresos o gastos rápidamente",
              "updatePeriodMillis": 86400000
            }
          ]
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-sqlite",
      "expo-sharing",
      "expo-image",
      "expo-web-browser",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f37882a6-afa9-4e90-b9df-519bce989a3b"
      }
    }
  }
}
