{
  "expo": {
    "name": "DriveWallet",
    "slug": "DriveWallet",
    "version": "5.4.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "com.jrdev.drivewallet",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/logo_new.png",
        "monochromeImage": "./assets/images/logo_new.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jrdev.DriveWallet"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/drivewallet_sinfondo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212",
          "image": "./assets/images/drivewallet_sinfondo.png",
          "imageWidth": 350
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "QuickAddWidget",
              "label": "DriveWallet Rápido",
              "minWidth": "150dp",
              "minHeight": "110dp",
              "description": "Agrega ingresos o gastos rápidamente",
              "updatePeriodMillis": 86400000
            }
          ]
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-sqlite",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f37882a6-afa9-4e90-b9df-519bce989a3b"
      }
    }
  }
}
